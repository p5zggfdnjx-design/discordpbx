# Discord ↔ FreePBX Bridge v3.4.0
#
# Fresh installs can leave most application settings blank and use /setup.
# Values here are bootstrap/Docker settings and legacy v2.x migration inputs.

# ================= Persistent data =================
DATA_DIR=/app/data
PBX_MASTER_KEY=

# ================= Discord bootstrap / legacy migration =================
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=
DISCORD_TEXT_CHANNEL_ID=
PBX_ROLE_IDS=
BOT_OWNER_IDS=
AUTO_JOIN_ON_START=false
LEAVE_VOICE_AFTER_CALL_SECONDS=20

# ================= Discord-local sound pack =================
DISCORD_SOUND_PACK_ENABLED=true
DISCORD_SOUND_PACK_GAIN=1.0
DISCORD_SOUND_PACK_DIR=/app/assets/sounds
PBX_HANGUP_SOUND_BURST_LIMIT=3
PBX_HANGUP_SOUND_WINDOW=60

# ================= PBX media =================
# auto       = use secure Asterisk WebSocket media when MEDIA_WS_PASSWORD is set;
#              otherwise retain legacy AudioSocket for an upgrade-safe fallback.
# websocket  = require true chan_websocket media; fail calls clearly if it is not configured.
# audiosocket= force the legacy AudioSocket() path.
PBX_MEDIA_TRANSPORT=auto

# True HD voice transport. Asterisk chan_websocket is available in Asterisk
# 20.16+, 21.11+, 22.6+, and 23+. slin16 is the recommended speech default:
# it carries actual 16 kHz signed-linear PCM instead of relabeling 8 kHz audio.
MEDIA_WS_BIND=0.0.0.0
MEDIA_WS_PORT=9093
MEDIA_WS_USERNAME=discordpbx
# Set a long random password and put the SAME value in websocket_client.conf.
# A blank password leaves the WebSocket media listener disabled in auto mode.
MEDIA_WS_PASSWORD=
MEDIA_WS_FORMAT=slin16
# plain-text works across all chan_websocket releases above. json may be selected
# on Asterisk versions that support JSON control messages (20.18+/22.8+/23.2+).
MEDIA_WS_CONTROL_FORMAT=plain-text
ASTERISK_MEDIA_CONNECTION=discordpbx_media

# Legacy AudioSocket fallback. Keep it during migration/rollback. The standard
# Asterisk AudioSocket() dialplan application is 8 kHz and is NOT true HD voice.
AUDIOSOCKET_BIND=0.0.0.0
AUDIOSOCKET_PORT=9092
AUDIOSOCKET_ADVERTISE_HOST=

PBX_TO_DISCORD_GAIN=1.0
DISCORD_TO_PBX_GAIN=1.0
INBOUND_CHIME_ENABLED=true
INBOUND_CHIME_FILE=/app/assets/retro-mail-chime.wav
INBOUND_CHIME_GAIN=0.85

# Inbound Discord voice recovery.
PBX_VOICE_CONNECT_ATTEMPTS=3
PBX_VOICE_CONNECT_TIMEOUT=10
PBX_VOICE_READY_TIMEOUT=15
PBX_VOICE_WATCHDOG_INTERVAL=2
PBX_INBOUND_PENDING_TTL=30
PBX_VOICE_WORKER_SETTLE_TIMEOUT=2.5
PBX_VOICE_WORKER_SETTLE_POLL=0.05
PBX_INBOUND_VOICE_PREWARM=true
PBX_INBOUND_STABILITY_GUARD=true
PBX_INBOUND_HANDSHAKE_WAIT=1.25
PBX_INBOUND_HANDSHAKE_POLL=0.05

# ================= FreePBX / Asterisk AMI bootstrap =================
ASTERISK_AMI_HOST=
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=
ASTERISK_AMI_SECRET=
ASTERISK_AMI_TIMEOUT=5
ASTERISK_DIAL_CONTEXT=from-internal
ASTERISK_DIAL_TIMEOUT_MS=45000
ASTERISK_CALLER_ID=
ASTERISK_CALLER_ID_OPTIONS=
ALLOW_CUSTOM_CALLER_ID=false
MAX_SIMULTANEOUS_CALLS=15

# ================= Web console =================
WEB_BIND=0.0.0.0
WEB_PORT=8088
WEB_AUTH_MODE=discord
WEB_USERNAME=pbx
WEB_PASSWORD=
PUBLIC_BASE_URL=
TRUST_PROXY_HEADERS=true
GITHUB_REPO=p5zggfdnjx-design/discordpbx
PBX_INGRESS_TOKEN=
CONTACTS_FILE=/app/data/contacts.json

# ================= Misc =================
TEST_AUDIO=/app/assets/test.mp3
LOG_LEVEL=INFO
