# Discord ↔ FreePBX Bridge v3.3.13
#
# Fresh installs can leave most application settings blank and use /setup.
# Values here are bootstrap/Docker settings and legacy v2.x migration inputs.

# ================= Persistent data =================
DATA_DIR=/app/data
# Optional: supply your own Fernet-compatible key material through Docker secrets/env.
# If blank, v3 creates /app/data/master.key (0600) automatically.
PBX_MASTER_KEY=

# ================= Discord bootstrap / legacy migration =================
# Fresh install: these may be entered in the first-run web setup instead.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Legacy single-guild values. When copied from v2.x, v3 automatically creates
# the initial "Main" workspace from them. New workspaces are managed in the UI.
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=
DISCORD_TEXT_CHANNEL_ID=
PBX_ROLE_IDS=
BOT_OWNER_IDS=

AUTO_JOIN_ON_START=false  # deprecated/ignored in v3.2; voice is on-demand
LEAVE_VOICE_AFTER_CALL_SECONDS=20

# ================= AudioSocket =================
AUDIOSOCKET_BIND=0.0.0.0
AUDIOSOCKET_PORT=9092
# Address of THIS bridge host as reachable from FreePBX.
AUDIOSOCKET_ADVERTISE_HOST=
PBX_TO_DISCORD_GAIN=1.0
DISCORD_TO_PBX_GAIN=1.0
INBOUND_CHIME_ENABLED=true
INBOUND_CHIME_FILE=/app/assets/retro-mail-chime.wav
INBOUND_CHIME_GAIN=0.85

# Inbound Discord voice recovery. Defaults are tuned for normal use; only change
# these when diagnosing slow Discord voice negotiation or unstable connectivity.
PBX_VOICE_CONNECT_ATTEMPTS=3
PBX_VOICE_CONNECT_TIMEOUT=10
PBX_VOICE_READY_TIMEOUT=15
PBX_VOICE_WATCHDOG_INTERVAL=2
PBX_INBOUND_PENDING_TTL=30
# v3.3.13 first-call reliability: allow fresh Discord audio workers to settle and
# optionally prewarm the selected workspace as soon as FreePBX registers a call.
PBX_VOICE_WORKER_SETTLE_TIMEOUT=2.5
PBX_VOICE_WORKER_SETTLE_POLL=0.05
PBX_INBOUND_VOICE_PREWARM=true

# ================= FreePBX / Asterisk AMI bootstrap =================
# Fresh install: these may be entered in /setup instead.
ASTERISK_AMI_HOST=
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=
ASTERISK_AMI_SECRET=
ASTERISK_AMI_TIMEOUT=5
ASTERISK_DIAL_CONTEXT=from-internal
ASTERISK_DIAL_TIMEOUT_MS=45000

# Default/legacy caller ID. The persistent Caller ID pool is managed in the UI.
ASTERISK_CALLER_ID=
ASTERISK_CALLER_ID_OPTIONS=
ALLOW_CUSTOM_CALLER_ID=false
MAX_SIMULTANEOUS_CALLS=15

# ================= Web console =================
WEB_BIND=0.0.0.0
WEB_PORT=8088

# discord = Discord OAuth + local break-glass admin (recommended)
# hybrid  = Discord/local sessions plus legacy HTTP Basic fallback
# basic   = legacy browser Basic auth
# none    = no application auth; only use behind another trusted auth layer
WEB_AUTH_MODE=discord
WEB_USERNAME=pbx
WEB_PASSWORD=

# HTTPS URL exposed through NPM/reverse proxy, no trailing slash.
# Discord OAuth callback becomes: PUBLIC_BASE_URL/auth/discord/callback
PUBLIC_BASE_URL=
TRUST_PROXY_HEADERS=true

# Canonical public repository used by Settings → Updates.
GITHUB_REPO=p5zggfdnjx-design/discordpbx

# Token used only by the FreePBX inbound metadata callback.
PBX_INGRESS_TOKEN=

# Legacy/current persistent path. Normally leave this alone in Docker.
CONTACTS_FILE=/app/data/contacts.json

# ================= Misc =================
TEST_AUDIO=/app/assets/test.mp3
LOG_LEVEL=INFO
